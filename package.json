{
  "name": "image-to-lottie",
  "version": "0.1.0",
  "description": "Turn AI-generated raster part images into Lottie JSON and dotLottie animations with motion presets, verified by headless Skottie rendering.",
  "type": "module",
  "bin": {
    "image-to-lottie": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "npm run build && node --test test/*.test.js"
  },
  "keywords": [
    "lottie",
    "dotlottie",
    "skottie",
    "animation",
    "ai",
    "agent-skill"
  ],
  "author": "nathankim0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathankim0/image-to-lottie.git"
  },
  "dependencies": {
    "@dotlottie/dotlottie-js": "^1.10.0",
    "canvaskit-wasm": "^0.42.0",
    "commander": "^15.1.0",
    "gifenc": "^1.0.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.9"
  }
}
